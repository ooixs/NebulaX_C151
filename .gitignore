# Raw datasets (copy from PS3/02_Datasets; never commit)
data/**
!data/**/.gitkeep

# Ignore experimental models; ship the four selected inference weights and manifests.
Door/model/*
ACV/model/*
Rail Corrugation/model/*
SHM/model/*
!*/model/.gitkeep
!/Door/model/door_model.joblib
!/Door/model/active_model.json
!/ACV/model/acv_model.joblib
!/ACV/model/active_model.json
!/Rail Corrugation/model/rail_model.joblib
!/Rail Corrugation/model/active_model.json
!/SHM/model/shm_model.joblib
!/SHM/model/active_model.json

# Training weights / checkpoints / CV fold models (large binaries) - keep the folders, not the files
weights/**
!weights/**/.gitkeep

# Generated submission artefacts (assembled into C151/ at packaging time, not versioned)
predictions.zip
demo_video.*
C151/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
Thumbs.db

# Local operator result history
app/.local/
